<script>
  var API_URL = "<%- api_url %>";
  var USER_TOEDIT =  "<%= (locals.user_edit) ? user_edit : ''; %>";
 </script>
<h2>Registrar Colaborador</h2>
<div id="wrapper">
<form action="#" id="registrarForm">
  Matricula:<br>
  <input type="text" name="registration" value="0000" id="registration">
  <br>
  Nome Completo:<br>
  <input type="text" name="name" value="Augusto" id="name">
  <br><br>
  Data Nascimento:<br>
  <input type="text" name="birth" value="24/04/1997" id="birth">
  <br><br>
  Avatar:<br>
  <input type="file" name="avatarimg" value="24/04/1997" id="avatarimg">
  <br><br>
  Setor:<br>
  <select id="selectSector" name="sector">
    <option>Choose a sector</option>
  </select>
  <br><br>
  Frente:<br>
  <select id="selectSubSector" name="subsector">
    <option>Choose a subsector</option>
  </select>
  <br><br>
  Funcão:<br>
  <select id="selectJob" name="job">
    <option>Choose a Job</option>
  </select>
  <br><br>
  Frota:<br>
  <input type="text" name="fleetid" placeholder="Ex: 1066" id="fleetid">
  <br><br>
  <input type="submit" id="btnsend" value="Send" name="send">
  <br><br>
  <input type="text" id="token">
  <br><br>
  <p class="feedback-msg"></p>
</form>
<span class="preview-img">
  <p>Avatar preview:</p>
  <img id="preview-avatar"/>
</span>
</div>
<script src="../../resource/vzX3ocip31" type="text/javascript"></script>
